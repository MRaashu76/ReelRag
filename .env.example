# ============================================================
# RAG Video Comparison Platform - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Required. Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── RapidAPI (Instagram Metadata Fallback) ────────────────────────────────────
# Optional. Required for accurate Instagram views and follower counts.
# Recommended API: "Instagram Scraper API" by mrngstar
RAPIDAPI_KEY=
RAPIDAPI_HOST=instagram-scraper-api2.p.rapidapi.com

# ── Application ───────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Supabase ────────────────────────────────────────────────────────────────────
# Get these from your Supabase dashboard (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=ey...

# ── Whisper ───────────────────────────────────────────────────────────────────
# Whisper model size: tiny | base | small | medium | large
# Larger = better quality but slower and more memory
WHISPER_MODEL=base

# ── Frontend ──────────────────────────────────────────────────────────────────
# Backend API URL (used in production/Docker deployments)
NEXT_PUBLIC_API_URL=http://localhost:8000

